# LLM Provider Configuration (Options: mock, gemini, openai, groq)
# Set LLM_PROVIDER=mock for offline, zero-API-key deterministic evaluation and testing
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash

# API Keys (Provide the key corresponding to chosen LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Target Brand & Data Configuration
TARGET_BRAND=AmazonHelp
DATA_SAMPLE_SIZE=10000
RANDOM_SEED=42
